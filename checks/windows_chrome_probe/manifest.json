{
  "manifest_version": 3,
  "name": "SyncUp native messaging probe",
  "description": "Test only (checks/check_windows_chrome.py): sends one request to the SyncUp native host and reports the answer.",
  "version": "1.0",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
