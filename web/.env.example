# 기본은 실제 로컬 수집기 연결. true는 예시 데이터 전용 데모.
NEXT_PUBLIC_USE_MOCK=false
# 확장 프로그램으로 연결할 때 false. 로컬 전용 웹 서버로 검증할 때만 true.
NEXT_PUBLIC_LOCAL_BRIDGE=false
# 로컬 전용 웹 서버에서만 설정. 브라우저에 공개되는 변수가 아님.
SYNCUP_CONNECTION_FILE=

# 운영 GitHub 가입 / PC 연결 (서버와 같은 Supabase 프로젝트)
NEXT_PUBLIC_SUPABASE_URL=https://gmwvivrmmzsrpdwdfeul.supabase.co
SYNCUP_WEB_ORIGIN=https://syncup-live-murex.vercel.app
SYNCUP_TEAM_API_URL=https://syncup-api-production-36de.up.railway.app

# 공개 설치파일 URL. 검증된 릴리스 파일만 지정한다.
NEXT_PUBLIC_DESKTOP_MAC_ARM64_URL=
NEXT_PUBLIC_DESKTOP_MAC_INTEL_URL=
NEXT_PUBLIC_DESKTOP_WINDOWS_URL=
