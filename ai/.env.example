# 외부 AI (OpenAI). ai/.env 로 복사해서 채운다 (.env 는 커밋 금지 — 레포 Public).
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# 문장 나누기·내용 정리·세부 주제·담당자·기한 추출용 chat 모델 (JSON 모드 지원 모델)
AI_MODEL=
AI_JSON_MODE=true

# Decisions API: 관련성·소주제·표시·변경 라벨, 충돌 판정, 확신도(확률).
# 비우면 chat 모델 라벨을 그대로 씀. 현재 문서상 지원 모델은 gpt-6-luna 하나.
AI_DECISIONS_MODEL=gpt-6-luna

# 비슷한 결정 찾기용 임베딩 모델. 비우면 글자 n-gram 유사도로 대신함 (API 호출 없음)
AI_EMBED_MODEL=
