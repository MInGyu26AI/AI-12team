# 외부 AI (OpenAI). ai/.env 로 복사해서 채운다 (.env 는 커밋 금지 — 레포 Public).
# 기본 경로: 아래 줄의 주석을 풀고 OPENAI_API_KEY 만 채운다 (셸 환경변수로 둬도 된다).
#   chat 은 Responses(gpt-6.1-terra), Decisions 는 gpt-6-luna. AI_BASE_URL·AI_API_KEY·AI_MODEL 은 비워 둔다.
# OPENAI_API_KEY=
# 다른 OpenAI 호환 공급자(또는 OpenAI chat/completions 를 직접 쓸 때): 세 값을 함께 채운다. 하나라도 채우면 기본 경로가 꺼진다.
AI_BASE_URL=
AI_API_KEY=
# 문장 나누기·내용 정리·세부 주제·담당자·기한 추출용 chat 모델 (JSON 모드 지원 모델)
AI_MODEL=
AI_JSON_MODE=true

# Decisions API: 관련성·소주제·표시·변경 라벨, 충돌 판정, 확신도(확률). 현재 문서상 지원 모델은 gpt-6-luna 하나.
# 기본 경로는 비워 두면 gpt-6-luna. 다른 공급자는 채웠을 때만 같은 주소·키로 부르고, 비우면 chat 모델 라벨을 그대로 쓴다.
# AI_DECISIONS_MODEL=gpt-6-luna
