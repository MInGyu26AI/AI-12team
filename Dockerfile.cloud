FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PORT=10000
WORKDIR /app
COPY server/requirements.txt ./
# Supabase's official public CA is required for verified pooler TLS; libpq uses it unless the DSN names another.
COPY server/supabase-ca.crt ./
ENV PGSSLROOTCERT=/app/supabase-ca.crt
RUN pip install --no-cache-dir -r requirements.txt
# Explicit source allowlist excludes local DBs, credentials, tests and reports.
COPY server/cloud_server.py server/team_server.py server/team_access.py server/team_board.py server/team_publish.py ./server/
COPY server/conflict_checks.py server/conflict_resolution.py server/conflict_scheduler.py server/repo_sync.py server/github_repo.py ./server/
COPY server/team_settings.py ./server/
COPY contract/secure_http.py contract/diagnostics.py contract/card_contract.py ./contract/
COPY ai/syncup_ai/*.py ./ai/syncup_ai/
COPY ai/prompts/*.md ./ai/prompts/
USER 65534:65534
EXPOSE 10000
CMD ["python", "server/cloud_server.py"]
